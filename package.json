{
  "name": "prettier-config-vladpuz",
  "version": "3.0.1",
  "description": "My Prettier config",
  "keywords": [
    "prettier",
    "prettierconfig"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladpuz/prettier-config-vladpuz.git"
  },
  "license": "MIT",
  "author": "Vladislav Puzyrev",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc --project tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm run format",
    "format": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build && npm run check",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sh": "^0.19.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-vladpuz": "^4.1.1",
    "husky": "^9.1.7",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  }
}
